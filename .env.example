# --- Frontend (públicas: se incrustan en el bundle) ---------------------
# Sin estas dos variables la web arranca en MODO VISTA PREVIA (contenido DEMO, sin guardado).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
# URL pública del sitio (canonical, Open Graph, sitemap)
VITE_SITE_URL=https://daleconto.do
# true solo si desplegaste la Edge Function notify-registration con RESEND_API_KEY
VITE_EMAIL_NOTIFICATIONS=false

# --- Solo servidor / scripts (NUNCA con prefijo VITE_, nunca en el navegador) ---
# Usada por `npm run make-admin -- correo@ejemplo.com` para designar el primer administrador.
SUPABASE_SERVICE_ROLE_KEY=
